# ===================================================
# BON MEETING RECAP - ENVIRONMENT CONFIGURATION
# ===================================================

# Server Configuration
PORT=3300
HOST=0.0.0.0

# Gemini Multimodal Audio Processing (Recommended: fastest, handles files up to 2GB)
# Provide your Gemini API key (or GOOGLE_API_KEY) for direct, high-fidelity audio recap.
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.6-flash

# AGY Fallback: used when GEMINI_API_KEY is not set (uses local Antigravity CLI / host bridge)
AGY_MODEL=gemini-3.8-flash-low
AGY_FALLBACK_MODEL=gemini-3.8-flash-medium
AGY_TIMEOUT_MS=600000
AGY_MAX_ATTEMPTS=2

# Direct mode (pnpm dev / pnpm start on the Windows host):
# AGY_COMMAND=agy

# Docker mode: the container calls the authenticated agy.exe through the local host bridge.
# Generate a random 32+ character value, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGY_BRIDGE_TOKEN=replace_with_a_long_random_secret
AGY_BRIDGE_URL=http://host.docker.internal:3310/v1/agy
# Absolute Windows path to this repository's data folder. Docker mounts ./data here.
AGY_HOST_DATA_DIR=C:/Users/Admin/Desktop/Bonario/bon-meeting-recap/data

# Session Secret (used for signing HMAC-SHA256 session cookies)
SESSION_SECRET=change_this_to_a_secure_random_string_in_production

# Odoo Development / Test Instance
ODOO_BASE_URL=https://skillbon.odoo.com
ODOO_DB=skillbon

# Odoo Production Instance
ODOO_PROD_BASE_URL=https://bonario-vietnam.odoo.com
ODOO_PROD_DB=bonario-vietnam

# excel-to-odoo-project Engine Path (optional, defaults to ../excel-to-odoo-project)
# ODOO_ENGINE_DIR=/path/to/excel-to-odoo-project

# Python binary to run CLI (default: uv, or python/python3)
ODOO_PYTHON_BIN=uv
